# Copy to .env.local for development. Never commit a filled-in .env file.
#
# Every variable here is NEXT_PUBLIC_ and therefore visible in the browser.
# That is correct for Paddle's client-side overlay checkout: the client token
# and price IDs are publishable values.
#
# The Paddle API key and webhook secret are SERVER-side secrets. This site has
# no server-side Paddle calls and no webhook handler, so they must not appear
# here or anywhere else in this repository.

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paddle ---------------------------------------------------------------
# "sandbox" or "production". Anything other than "production" is treated as
# sandbox, so a misconfigured deploy cannot take real money by accident.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Paddle Dashboard > Developer tools > Authentication > Client-side tokens.
# Sandbox tokens start with test_; live tokens start with live_.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...

# Paddle Dashboard > Catalog > Products > (your product) > Prices.
# These must come from the same environment as the token above.
NEXT_PUBLIC_PADDLE_PRICE_ID_TIER_1=pri_...
NEXT_PUBLIC_PADDLE_PRICE_ID_TIER_2=pri_...
